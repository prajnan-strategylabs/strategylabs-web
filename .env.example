# Strategy Labs — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local (already in .gitignore)

# ── Supabase (required) ──────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
#
# New key format (post-2024 migration):
#   - PUBLISHABLE key: safe in browser, starts with `sb_publishable_...`
#                      (replaces the old `anon` JWT key)
#   - SECRET key:      server-only, starts with `sb_secret_...`
#                      (replaces the old `service_role` JWT key)
#                      NEVER prefix with VITE_ — it would leak to the browser

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# For future server-side use (Python backend, edge functions, admin scripts).
# NOT used by the Vite frontend. Keep it out of any VITE_ var.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Backend API ──────────────────────────────────────────────────────────────
# FastAPI backend deployed on fly.io.
# Leave blank in dev if you're running the API locally on :8080 (default).
VITE_API_URL=https://strategylabs-api.fly.dev

# ── Over-the-air updates ────────────────────────────────────────────────────
# Only used by `npm run publish:ota`; never expose this in VITE_ variables.
# Set the same value as LIVE_UPDATE_DEPLOY_SECRET on strategylabs-api.
DEPLOY_SECRET=replace-with-a-long-random-secret

# ── Site (used in emails, OG tags, etc.) ─────────────────────────────────────
VITE_SITE_URL=https://strategylabs.trade
VITE_SITE_NAME=Strategy Labs

# ── RevenueCat (required for native payments) ────────────────────────────────
VITE_REVENUECAT_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
